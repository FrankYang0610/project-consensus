# Example environment file (safe to commit)
#
# Usage:
#   cp env.example .env
#
# Notes:
# - Do NOT commit `.env` (it contains secrets).
# - Demo seed migrations are opt-in. Set `SEED_DEMO_DATA=true` only in dev/staging.

# ==================== Django ====================
SECRET_KEY=change-me-in-production
DEBUG=True
SEED_DEMO_DATA=true

# Comma-separated
ALLOWED_HOSTS=127.0.0.1,localhost

# Required (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# Frontend base URL (used in password reset links, etc.)
FRONTEND_BASE_URL=http://localhost:3000

# ==================== CORS / CSRF ====================
# Comma-separated origins with scheme
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Production (same-site subdomain deployment) examples:
# SESSION_COOKIE_DOMAIN=.your-domain.com
# CSRF_COOKIE_DOMAIN=.your-domain.com
# SESSION_COOKIE_SAMESITE=Lax
# CSRF_COOKIE_SAMESITE=Lax

# ==================== Redis ====================
# docker-compose.yml enables requirepass=redis_secure_password
CELERY_BROKER_URL=redis://:redis_secure_password@localhost:6379/0
NOTIFICATIONS_REDIS_URL=redis://:redis_secure_password@localhost:6379/1
CACHE_URL=redis://:redis_secure_password@localhost:6379/2

# ==================== SSE (Server-Sent Events) ====================
# Enable/disable real-time notification updates via SSE
# When disabled, the SSE stream endpoint returns 503 and clients fall back to manual refresh
# This helps reduce server CPU usage when real-time updates are not needed
NOTIFICATIONS_SSE_ENABLED=false

# ==================== Email (Resend) ====================
EMAIL_ENABLED=false
EMAIL_USE_CELERY=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=PolyU Life <noreply@polyu.life>
EMAIL_REPLY_TO=noreply@polyu.life

# ==================== Cloudflare R2 (S3-compatible) ====================
# Required by current settings to boot the app. Dummy values are OK for local dev
# as long as you don't use the upload endpoints.
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=your_bucket_name
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_PUBLIC_DOMAIN=your_public_domain.r2.dev

# ==================== Image upload limits (optional) ====================
MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_PIXELS=50000000
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_IMAGE_HOSTS=image.polyu.life


