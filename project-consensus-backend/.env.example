# ==================== Django Core Settings ====================
# SECURITY WARNING: keep the secret key used in production secret!
# Generate a new key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# MARK: Generate and set your own SECRET_KEY
SECRET_KEY=your-secret-key-here-change-in-production

# SECURITY WARNING: don't run with debug turned on in production!
# MARK: Set DEBUG=False in production! For local development, leave as True.
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
# Example: yourdomain.com,api.yourdomain.com,127.0.0.1,localhost
# MARK: Set your domain names
ALLOWED_HOSTS=localhost,127.0.0.1

# Internationalization
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Hong_Kong


# ==================== Database Configuration ====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# For Docker: Use the service name as host (e.g., db instead of localhost)
# MARK: Configure your database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb


# ==================== CORS and CSRF Settings ====================
# Cross-Origin Resource Sharing allowed origins (comma-separated, no spaces)
# Example: http://localhost:3000,https://yourdomain.com
# MARK: Set your frontend URL(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF trusted origins (comma-separated, no spaces)
# Must include the protocol (http:// or https://)
# MARK: Set your trusted origins (frontend and backend URLs)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Cookie settings for cross-domain requests
# Set to 'None' for cross-domain, 'Lax' or 'Strict' for same-domain
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None

# Cookie domain for cross-subdomain sharing
# Example: .yourdomain.com (note the leading dot)
# MARK: Set your cookie domain (use leading dot for subdomains)
CSRF_COOKIE_DOMAIN=.yourdomain.com
# MARK: Set your session cookie domain (use leading dot for subdomains)
SESSION_COOKIE_DOMAIN=.yourdomain.com


# ==================== Cloudflare R2 Storage Configuration ====================
# Get these values from: https://dash.cloudflare.com/
# Navigate to: R2 → Manage R2 API Tokens

# Cloudflare Account ID (found in R2 dashboard URL)
# MARK: Set your Cloudflare R2 Account ID
R2_ACCOUNT_ID=your-account-id-here

# R2 Bucket name
# MARK: Set your R2 bucket name
R2_BUCKET_NAME=your-bucket-name

# R2 API credentials (create from R2 → Manage R2 API Tokens)
# MARK: Set your R2 Access Key ID
R2_ACCESS_KEY_ID=your-access-key-id
# MARK: Set your R2 Secret Access Key
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Public domain for R2 bucket
# Option 1: Use R2 public domain (pub-xxxxx.r2.dev)
# Option 2: Use custom domain (Settings → Custom Domains → Add Domain)
#           CNAME: images.yourdomain.com → bucket-name.your-account-id.r2.cloudflarestorage.com
# MARK: Set your R2 public domain (R2 public URL or custom domain)
R2_PUBLIC_DOMAIN=https://pub-xxxxx.r2.dev


# ==================== Image Upload Settings ====================
# Maximum image file size in megabytes
MAX_IMAGE_SIZE_MB=5

# Maximum image resolution (width × height)
MAX_IMAGE_PIXELS=50000000

# Allowed image file types (comma-separated, no spaces)
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp


# ==================== Email Service Configuration (Resend) ====================
# Resend API Configuration for sending transactional emails
# Get your API key from: https://resend.com/api-keys
# Domain verification required at: https://resend.com/domains

# Enable/disable email sending (set to False for development to use console logs)
EMAIL_ENABLED=False

# Resend API Key (required when EMAIL_ENABLED=True)
# Example: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MARK: Set your Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# Email sender address (must be verified domain in Resend)
# Format: "Display Name <email@domain.com>"
# MARK: Set your sender email address (must be verified in Resend)
EMAIL_FROM_ADDRESS=Your App <noreply@yourdomain.com>

# Reply-to address for user responses
# MARK: Set your reply-to email address
EMAIL_REPLY_TO=noreply@yourdomain.com

# Email API timeout in seconds
EMAIL_TIMEOUT_SECONDS=10


# ==================== Email Verification Settings ====================
# Verification code time-to-live in seconds (default: 900 = 15 minutes)
AUTH_VERIFICATION_CODE_TTL_SECONDS=900

# Minimum interval between verification code requests per email in seconds
AUTH_VERIFICATION_REQUEST_INTERVAL_SECONDS=90


# ==================== Password Reset Configuration ====================
# Frontend base URL for generating password reset links (no trailing slash)
# This should be your frontend application URL
# MARK: Set your frontend URL for password reset links
FRONTEND_BASE_URL=http://localhost:3000

# Password reset token timeout in seconds (default: 3600 = 1 hour)
PASSWORD_RESET_TIMEOUT=3600

# Minimum interval between password reset requests per email in seconds
PASSWORD_RESET_REQUEST_INTERVAL_SECONDS=300


# ==================== Celery Configuration (Async Task Queue) ====================
# Enable asynchronous email sending via Celery (recommended for production)
# Set to True to send emails in background, False for synchronous sending
EMAIL_USE_CELERY=False

# Redis URL for Celery broker (required when EMAIL_USE_CELERY=True)
# Format: redis://[username:password@]host:port/database
# Important: Password must match the password in docker-compose.yml (--requirepass)
# MARK: Set your Redis password and connection details
CELERY_BROKER_URL=redis://:redis_secure_password@localhost:6379/0

# Celery result backend (optional)
# Use 'rpc://' for temporary results or Redis URL for persistent results
# Example: redis://:redis_secure_password@localhost:6379/1
CELERY_RESULT_BACKEND=rpc://


# ==================== Notifications & SSE Configuration ====================
# Redis connection for real-time notifications runtime
# If not set, falls back to CELERY_BROKER_URL
# Use a different database number (e.g., /1) to separate from Celery
# MARK: Set your Redis password and connection details for notifications
NOTIFICATIONS_REDIS_URL=redis://:redis_secure_password@localhost:6379/1

# Redis key prefixes for notification channels
NOTIFICATIONS_REDIS_CHANNEL_PREFIX=notifications:chan:
NOTIFICATIONS_REDIS_SEQ_PREFIX=notifications:seq:
NOTIFICATIONS_REDIS_BACKLOG_PREFIX=notifications:backlog:

# Redis connection settings for notifications (optional, with sensible defaults)
NOTIFICATIONS_REDIS_SOCKET_TIMEOUT=1.0
NOTIFICATIONS_REDIS_SOCKET_CONNECT_TIMEOUT=1.0
NOTIFICATIONS_REDIS_HEALTH_CHECK_INTERVAL=30

# Maximum number of notifications to keep in backlog per user
NOTIFICATIONS_REDIS_BACKLOG_SIZE=200

# ==================== Backend Configuration ====================
# Backend base URL for internal API calls
# MARK: Set your backend URL (for production, use your actual API domain)
BACKEND_BASE_URL=http://127.0.0.1:8000
